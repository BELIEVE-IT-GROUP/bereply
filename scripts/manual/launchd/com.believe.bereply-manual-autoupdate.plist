<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.believe.bereply-manual-autoupdate</string>
  <key>ProgramArguments</key><array>
    <string>/bin/bash</string>
    <string>/Users/mac/.believe/bin/bereply-manual-autoupdate.sh</string>
  </array>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>/opt/homebrew/opt/node@24/bin:/Users/mac/.local/bin:/opt/homebrew/bin:/usr/bin:/bin</string></dict>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>40</integer></dict>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/Users/mac/Library/Logs/bereply-manual-autoupdate.log</string>
  <key>StandardErrorPath</key><string>/Users/mac/Library/Logs/bereply-manual-autoupdate.log</string>
</dict></plist>
